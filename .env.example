# Product state store (R7: two tiers only)
#   surreal = the single durable tier (embedded SurrealDB / surrealkv; graph + vector + hybrid search). Recommended.
#   memory  = non-durable, for tests / throwaway demos (data resets on restart).
# Unset / any other value defaults to surreal. Legacy sqlite/dual/dual-surreal are removed and coerced to surreal.
PRODUCT_STORE=surreal
# State DB path: the surreal data dir lives next to this path (<dir>/surreal). Set to memory/:memory:/in-memory for the memory tier.
PRODUCT_STATE_DB_PATH=.data/product-state.db

# Bailian / DashScope
DASHSCOPE_API_KEY=sk-your-bailian-key
BAILIAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_AUDIO_BASE_URL=https://dashscope.aliyuncs.com

# Text and built-in web tools
BAILIAN_MODEL=deepseek-v4-flash-0731
BAILIAN_GENERAL_MODEL=deepseek-v4-flash-0731
BAILIAN_SEARCH_MODEL=deepseek-v4-flash-0731

# Optional external search provider
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_LANGUAGE=zh-CN
ANYSEARCH_ZONE=intl
# Keep false by default so missing keys degrade visibly instead of silently using anonymous quota.
ANYSEARCH_ALLOW_ANONYMOUS=false

# Interview role-play
BAILIAN_CHARACTER_MODEL=deepseek-v4-flash-0731

# Realtime bidirectional voice (Omni E2E path; cascade default still preferred for interviews)
# Profile selects the model family. Only "omni-default" is live today.
# "audio3-flash" is reserved for a future Audio3 path (PR-8; currently falls back to omni-default).
# BAILIAN_REALTIME_PROFILE=omni-default
BAILIAN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
BAILIAN_REALTIME_FALLBACK_MODEL=qwen3-omni-flash-realtime
# Transport: "websocket" (default) or "webrtc".
# WebRTC: browser offers SDP via Product API; server proxies to DashScope public signaling.
# No workspace allowlist required. Cascade path still preferred for interviews.
BAILIAN_REALTIME_TRANSPORT=websocket
BAILIAN_REALTIME_VAD=server_vad
# Omni Realtime session voice (Qwen-Omni family). Not a CosyVoice id — Cosy TTS uses BAILIAN_TTS_VOICE below.
BAILIAN_REALTIME_VOICE=Ethan
BAILIAN_REALTIME_ENABLE_SEARCH=false
# Optional override of public DashScope WebRTC signaling (default: https://dashscope.aliyuncs.com/api/v1/webrtc/realtime).
# BAILIAN_REALTIME_WEBRTC_ENDPOINT=

# LiveKit realtime voice (optional, used by the external Python LiveKit agent + /api/realtime-voice/livekit-token).
# Required only if you run the LiveKit transport; the endpoint 503s when unset.
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Podcast / CosyVoice audio rendering
BAILIAN_TTS_MODEL=cosyvoice-v3-plus
BAILIAN_TTS_VOICE=longanyang
# CosyVoice tuning knobs (all optional; shown values are the built-in defaults).
BAILIAN_TTS_FORMAT=mp3
BAILIAN_TTS_SAMPLE_RATE=24000
BAILIAN_TTS_RATE=0.95
BAILIAN_TTS_ENABLE_MARKDOWN_FILTER=true
BAILIAN_TTS_ENABLE_AIGC_TAG=true

# Corpus audio upload (local Product API path by default)
CORPUS_UPLOAD_DIR=.data/corpus-audio
CORPUS_AUDIO_MAX_BYTES=52428800
# Public base URL SenseVoice can fetch after local upload (optional).
CORPUS_AUDIO_PUBLIC_BASE_URL=
# Optional cloud presign: when CORPUS_S3_BUCKET + AWS credentials are set,
# POST /api/corpus/audio-files/presign returns an S3 SigV4 PutObject URL.
CORPUS_S3_BUCKET=
CORPUS_S3_REGION=
CORPUS_S3_ENDPOINT=
# true/false; default true when ENDPOINT is set (OSS/MinIO path-style)
CORPUS_S3_FORCE_PATH_STYLE=
CORPUS_S3_PUBLIC_BASE_URL=
# Comma-separated hosts allowed for outbound audio fetch even if private (SSRF allowlist)
# CORPUS_AUDIO_URL_ALLOWLIST=minio.local,10.0.0.5
# Rate limit (in-process). Vitest disables by default; set RATE_LIMIT_DISABLED=false to force on in tests.
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_MAX=60
# RATE_LIMIT_STRICT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# LLM call budget (counts calls, not USD/tokens). See docs/COST-ENVELOPE.md
# LLM_MAX_CALLS_PER_SESSION=200
# LLM_SYSTEM_WINDOW_MS=3600000
# Prefer standard AWS_* names; CORPUS_S3_* aliases also work.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_SESSION_TOKEN=
# CORPUS_S3_ACCESS_KEY_ID=
# CORPUS_S3_SECRET_ACCESS_KEY=
# CORPUS_S3_REGION=
# CORPUS_S3_SESSION_TOKEN=

# OpenTelemetry (optional). The SDK auto-initializes on boot and exports OTLP/HTTP traces.
# Defaults to http://localhost:4318; set OTEL_SDK_DISABLED=true to turn it off entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=interview-product-api
# OTEL_SDK_DISABLED=true

# --- Auth (optional for local; recommended production) ---
# DEPLOYMENT_PROFILE=production activates machine token guard when PRODUCT_API_TOKEN is set.
# PRODUCT_AUTH_ENABLED=1 activates username/password + zf_session (L1). See docs/L1-AUTH-SESSION-PLAN.md
# PRODUCT_API_TOKEN=
# PRODUCT_AUTH_ENABLED=1
# PRODUCT_SESSION_SECRET=
# PRODUCT_BOOTSTRAP_USERS=admin:local-dev-pass
# PRODUCT_SESSION_SECURE=0
# PRODUCT_SESSION_TTL_HOURS=168
# PRODUCT_LEGACY_OWNER=admin
# PRODUCT_USER_SCOPED_STATE=0
# PRODUCT_AUTH_DB=.data/auth-users.json
