# Product state store (R7: two tiers only)
#   surreal = the single durable tier (embedded SurrealDB / surrealkv; graph + vector + hybrid search). Recommended.
#   memory  = non-durable, for tests / throwaway demos (data resets on restart).
# Unset / any other value defaults to surreal. Legacy sqlite/dual/dual-surreal are removed and coerced to surreal.
PRODUCT_STORE=surreal
# State DB path: the surreal data dir lives next to this path (<dir>/surreal). Set to memory/:memory:/in-memory for the memory tier.
PRODUCT_STATE_DB_PATH=.data/product-state.db

# Bailian / DashScope
DASHSCOPE_API_KEY=sk-your-bailian-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_AUDIO_BASE_URL=https://dashscope.aliyuncs.com

# Text and built-in web tools
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_SEARCH_MODEL=qwen3.7-plus

# Optional external search provider
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_LANGUAGE=zh-CN
ANYSEARCH_ZONE=intl
# Keep false by default so missing keys degrade visibly instead of silently using anonymous quota.
ANYSEARCH_ALLOW_ANONYMOUS=false

# Interview role-play
BAILIAN_CHARACTER_MODEL=qwen-plus-character

# Realtime bidirectional voice
BAILIAN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
BAILIAN_REALTIME_FALLBACK_MODEL=qwen3.5-omni-flash-realtime
# Transport: "websocket" (default, fully implemented) or "webrtc". NOTE: the browser client
# does NOT yet implement the WebRTC offer/answer flow and falls back to WebSocket, so keep
# this on websocket unless/until the frontend WebRTC path lands.
BAILIAN_REALTIME_TRANSPORT=websocket
BAILIAN_REALTIME_VAD=server_vad
BAILIAN_REALTIME_VOICE=Ethan
BAILIAN_REALTIME_ENABLE_SEARCH=false
# Only used when BAILIAN_REALTIME_TRANSPORT=webrtc. Requires an allowlisted endpoint from Bailian.
BAILIAN_REALTIME_WEBRTC_ENDPOINT=https://your-allowlisted-realtime-endpoint.example.com

# LiveKit realtime voice (optional, used by the external Python LiveKit agent + /api/realtime-voice/livekit-token).
# Required only if you run the LiveKit transport; the endpoint 503s when unset.
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Podcast / CosyVoice audio rendering
BAILIAN_TTS_MODEL=cosyvoice-v3-plus
BAILIAN_TTS_VOICE=longanyang
# CosyVoice tuning knobs (all optional; shown values are the built-in defaults).
BAILIAN_TTS_FORMAT=mp3
BAILIAN_TTS_SAMPLE_RATE=24000
BAILIAN_TTS_RATE=0.95
BAILIAN_TTS_ENABLE_MARKDOWN_FILTER=true
BAILIAN_TTS_ENABLE_AIGC_TAG=true

# OpenTelemetry (optional). The SDK auto-initializes on boot and exports OTLP/HTTP traces.
# Defaults to http://localhost:4318; set OTEL_SDK_DISABLED=true to turn it off entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=interview-product-api
# OTEL_SDK_DISABLED=true
