# Copy to .env.production.local or pass with: docker compose --env-file .env.production.local up --build
# Do not commit real provider keys.

PORT=3210
DEPLOYMENT_PROFILE=production

# REQUIRED: machine Bearer for LiveKit agent / CI / scripts (never for browser login UX).
PRODUCT_API_TOKEN=change-me-to-a-long-random-secret

# L1 human auth: username/password → HttpOnly zf_session cookie
PRODUCT_AUTH_ENABLED=1
# Required when PRODUCT_AUTH_ENABLED=1 (session HMAC signing key; long random)
PRODUCT_SESSION_SECRET=change-me-to-another-long-random-secret
# Seed users only when auth DB is empty: user:pass,user2:pass2
PRODUCT_BOOTSTRAP_USERS=admin:change-me-strong-password
PRODUCT_SESSION_SECURE=1
# PRODUCT_SESSION_TTL_HOURS=168
# PRODUCT_LEGACY_OWNER=admin
# P1 multi-user ProductState isolation (default off = shared state for all logins)
# PRODUCT_USER_SCOPED_STATE=0

PRODUCT_WEB_ORIGINS=http://127.0.0.1:3210,http://localhost:3210,https://www.example.com,https://example.com

# Product state store (R7): surreal is the single durable tier and the default.
# memory is non-durable (resets on restart) — never use it in production.
PRODUCT_STORE=surreal
PRODUCT_STATE_DB_PATH=.data/product-state.db

# Leave blank for same-origin frontend -> Product API calls inside the production container.
VITE_PRODUCT_API_BASE_URL=

DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
# Official DashScope key for voice clone. Token-plan keys cannot call voice-enrollment.
# VOICE_ENROLLMENT_API_KEY=
# BAILIAN_VOICE_ENROLLMENT_BASE_URL=https://dashscope.aliyuncs.com
BAILIAN_REALTIME_WEBRTC_ENDPOINT=

ANYSEARCH_API_KEY=
ANYSEARCH_ALLOW_ANONYMOUS=false
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Public origin DashScope uses to fetch voice-clone samples (no auth).
# /api is on the host root; /zhuanfang is only the SPA prefix.
CORPUS_AUDIO_PUBLIC_BASE_URL=https://zhuanfang.example.com
PRODUCT_PUBLIC_PATH=/zhuanfang
# Optional S3/OSS corpus presign (path-style when ENDPOINT set)
# CORPUS_S3_BUCKET=
# CORPUS_S3_REGION=
# CORPUS_S3_ENDPOINT=
# CORPUS_S3_FORCE_PATH_STYLE=true
# CORPUS_S3_PUBLIC_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SSRF allowlist for private audio hosts (comma-separated). Leave empty in pure public deploys.
# CORPUS_AUDIO_URL_ALLOWLIST=

# In-process rate limits (do NOT set RATE_LIMIT_DISABLED=true in production)
# RATE_LIMIT_MAX=60
# RATE_LIMIT_STRICT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# LLM call budget (not USD metering)
# LLM_MAX_CALLS_PER_SESSION=200
# LLM_SYSTEM_WINDOW_MS=3600000

PROVIDER_SMOKE_TEST_AUDIO_URL=
PROVIDER_SMOKE_TEST_WEBRTC_OFFER_SDP=

# Full deployment checklist: docs/DEPLOYMENT-CHECKLIST.md
