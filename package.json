{
  "name": "interview-product-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:vad-assets": "node scripts/copy-vad-assets.mjs",
    "postinstall": "node scripts/copy-vad-assets.mjs",
    "dev": "npm run copy:vad-assets && vite",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "npm run copy:vad-assets && tsc -b && tsc -p apps/api/tsconfig.json && vite build",
    "start:api": "tsx apps/api/src/server.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:real": "E2E_REAL=1 playwright test",
    "smoke:voice-static": "node scripts/voice-static-smoke.mjs",
    "preview": "vite preview",
    "typecheck:api": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -b && tsc -p apps/api/tsconfig.json && tsc -p packages/db/tsconfig.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@ricky0123/vad-web": "^0.0.27",
    "@surrealdb/node": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "fastify": "^5.8.5",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "surrealdb": "^2.0.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "jsdom": "^26.1.0",
    "vitest": "^4.0.15"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true
  }
}
