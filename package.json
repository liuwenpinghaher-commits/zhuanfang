{
  "name": "interview-product-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && tsc -p apps/api/tsconfig.json && vite build",
    "start:api": "tsx apps/api/src/server.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "typecheck:api": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -b && tsc -p apps/api/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@livekit/components-react": "^2.9.21",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.4",
    "vitest": "^4.0.15"
  }
}
